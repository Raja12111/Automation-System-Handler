{
  "framework": null,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/admin/page-status", "destination": "/api/admin/api-usage?resource=page-status" },
    { "source": "/api/admin/notifications", "destination": "/api/admin/api-usage?resource=notifications" },
    { "source": "/api/admin/tickets", "destination": "/api/admin/api-usage?resource=tickets" },
    { "source": "/api/admin/tickets/:id", "destination": "/api/admin/api-usage?resource=tickets&id=:id" },
    { "source": "/api/admin/blog", "destination": "/api/admin/api-usage?resource=blog" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, X-Handler-Secret, X-OptiSync-Source" }
      ]
    }
  ]
}
