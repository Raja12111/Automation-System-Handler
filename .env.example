# Shared secret OptiSync / RankBrain X sends as Authorization: Bearer <secret>
HANDLER_SECRET="replace-with-a-long-random-secret"

# RankBrain X production URL the handler calls back into
OPTISYNC_URL="https://rankbrainx.com"

# Optional: only accept callbacks/jobs from this origin
OPTISYNC_ALLOWED_ORIGIN="https://rankbrainx.com"
