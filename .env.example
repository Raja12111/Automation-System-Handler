# Shared secret OptiSync sends as Authorization: Bearer <secret>
HANDLER_SECRET="replace-with-a-long-random-secret"

# OptiSync production URL the handler can call back into
OPTISYNC_URL="https://opti-sync-pied.vercel.app"

# Optional: only accept callbacks/jobs from this origin
OPTISYNC_ALLOWED_ORIGIN="https://opti-sync-pied.vercel.app"
